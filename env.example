# Copia este archivo y renómbralo a ".env" antes de correrlo localmente.
# En Render, estas variables se configuran en el panel, no en un archivo.

PORT=3000

# Datos de tu cuenta de Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número del WhatsApp Sandbox de Twilio, con el formato exacto:
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Tu API key de Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Tu API key de OpenAI, solo se usa para transcribir audios (platform.openai.com)
OPENAI_API_KEY=

# Datos de tu base en Airtable (airtable.com)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Gastos
